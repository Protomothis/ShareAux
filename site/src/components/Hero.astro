---
interface Props {
  title: string;
  titleAccent: string;
  subtitle: string;
  cta1: string;
  cta2: string;
  lang?: string;
}
const { title, titleAccent, subtitle, cta1, cta2, lang = 'en' } = Astro.props;
const guideHref = lang === 'ko' ? '/ShareAux/ko/guide/' : '/ShareAux/guide/';
---

<section class="relative min-h-[90vh] flex flex-col items-center justify-center px-6 text-center overflow-hidden">
  <!-- Glow background -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full bg-sa-accent/10 blur-[120px] pointer-events-none"></div>
  <div class="absolute top-1/3 left-1/3 w-[400px] h-[400px] rounded-full bg-sa-cyan/5 blur-[100px] pointer-events-none"></div>

  <h1 class="relative text-4xl md:text-6xl lg:text-7xl font-bold leading-tight animate-fade-up">
    {title}<br /><span class="bg-gradient-to-r from-sa-accent to-sa-cyan bg-clip-text text-transparent">{titleAccent}</span>
  </h1>
  <p class="relative mt-6 text-lg md:text-xl text-sa-text2 max-w-2xl animate-fade-up whitespace-pre-line" style="animation-delay: 0.1s">{subtitle}</p>
  <div class="relative mt-10 flex flex-wrap gap-4 justify-center animate-fade-up" style="animation-delay: 0.2s">
    <a href="https://github.com/Protomothis/ShareAux" target="_blank" rel="noopener"
      class="px-6 py-3 bg-sa-accent hover:bg-sa-accent-hover text-white font-semibold rounded-lg transition-all hover:shadow-[0_0_24px_rgba(255,64,129,0.4)]">
      {cta1}
    </a>
    <a href={guideHref}
      class="px-6 py-3 border border-white/20 hover:border-sa-accent/50 text-sa-text rounded-lg transition-all">
      {cta2}
    </a>
  </div>
  <!-- Demo video -->
  <div class="relative mt-16 w-full max-w-4xl animate-fade-up" style="animation-delay: 0.3s">
    <div class="absolute inset-0 rounded-xl bg-gradient-to-br from-sa-accent/20 via-transparent to-sa-cyan/20 blur-xl"></div>
    <video
      src="/ShareAux/images/demo.webm"
      autoplay
      muted
      loop
      playsinline
      class="relative w-full rounded-xl border border-white/10 shadow-2xl"
    ></video>
  </div>
</section>
